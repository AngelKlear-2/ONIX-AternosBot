# Behavior (true / false)
MC_AVOID_MOBS=false
MC_AVOID_CLIFFS=true
MC_AVOID_WATER=true

# Timers
# Быстрая фаза реконнекта: первые N попыток через MC_RECONNECT_INTERVAL_MS.
# Затем бот переходит в медленный режим (MC_SLOW_RETRY_INTERVAL_MS) и продолжает БЕСКОНЕЧНО.
MC_RECONNECT_INTERVAL_MS=30000
MC_SLOW_RETRY_AFTER=5
MC_SLOW_RETRY_INTERVAL_MS=300000
MC_RANDOM_ACTION_INTERVAL_MS=60000
MC_STATUS_INTERVAL_MS=3600000
MAX_LOG_LINES=80
TG_NOTIFICATION_TTL_MS=10000
TG_LOGS_TTL_MS=30000

# Debug
# true → каждое AFK-действие пишется в лог. false → лог чище, виден только важный диагностический трафик.
MC_VERBOSE_AFK=false

# AI / Pathfinder
# Радиус обнаружения враждебных мобов (16 = видим скелетов до выстрелов)
MC_DETECTION_RADIUS=16
# Интервал сканирования (мс)
MC_MOB_SCAN_INTERVAL_MS=500
# Дистанция бегства (целевое удаление от моба)
MC_FLEE_DISTANCE=16
# Таймаут поиска пути pathfinder (мс) — защита от freeze
MC_PATHFIND_TIMEOUT_MS=1500
# Stuck-recovery: порог простоя и интервал проверки
MC_STUCK_TIMEOUT_MS=10000
MC_STUCK_SCAN_INTERVAL_MS=2000
# AFK через pathfinder (true → бот гуляет умно, обходит препятствия)
MC_SMART_AFK=true
# Бой: если есть оружие в инвентаре — атаковать слабых мобов (зомби/скелет/паук в ближнем бою)
# Никогда не атакует крипера/варден-а/боссов даже при true
MC_COMBAT_ENABLED=false

